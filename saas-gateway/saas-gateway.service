[Unit]
Description=Hookah POS SaaS onboarding gateway (createTenant/createBuildJob without Blaze)
After=network.target

[Service]
Type=simple
User=saas-gateway
WorkingDirectory=/opt/saas-gateway
EnvironmentFile=/etc/saas-gateway.env
ExecStart=/usr/bin/node /opt/saas-gateway/server.js
Restart=on-failure
RestartSec=3
# Слушает только 127.0.0.1 (см. server.js) — наружу торчит только nginx.
#
# NoNewPrivileges НЕ включаем (хотя обычно стоило бы): provisionTenantDomain
# в server.js зовёт `sudo provision-tenant-domain.sh` для автовыпуска
# сертификата поддомена нового заведения — NoNewPrivileges блокирует ЛЮБОЙ
# setuid-переход, включая sudo, даже с настроенным sudoers-правилом. Цена
# компенсируется узостью самого правила (см. saas/README.md — sudo разрешён
# ТОЛЬКО на этот один скрипт, не на произвольные команды).
PrivateTmp=true

[Install]
WantedBy=multi-user.target
