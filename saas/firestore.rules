rules_version = '2';

// Правила платформы ZalPOS (проект saas-3bdc8). Корневой firestore.rules —
// другое приложение: одно заведение в hoocah-pos.
//
// users/{uid} — аккаунт человека (email, не анонимный); superAdmins/{uid} —
// супер-админы платформы; tenants/{id} — заведение; tenantMembers/
// {tenantId}_{uid} — доступ к нему с ролью (у одного человека в разных
// заведениях роли разные). Рабочие данные лежат под tenants/{id}/..., и
// изоляция везде проверяется одинаково: есть ли активное членство в этом
// tenantId.
//
// Гости анонимны и членства не имеют: им открыт узкий набор документов
// заведения, где у них есть профиль clients.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- Платформенный супер-админ ----
    // Супер-админ — и его сеанс не завершён кнопкой «Выйти на всех
    // устройствах» (sessionsValidAfter, секунды; ставит только
    // saas-gateway, см. handleRevokeAdminSessions): без этой проверки уже
    // выданный токен продолжал бы открывать панель ещё до часа.
    function isSuperAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid)) &&
        adminSessionFresh(get(/databases/$(database)/documents/superAdmins/$(request.auth.uid)).data);
    }

    function adminSessionFresh(sa) {
      return !('sessionsValidAfter' in sa) || request.auth.token.auth_time > sa.sessionsValidAfter;
    }

    // ---- Членство в заведении ----
    function memberId(tenantId) {
      return tenantId + '_' + request.auth.uid;
    }

    function memberDoc(tenantId) {
      return get(/databases/$(database)/documents/tenantMembers/$(memberId(tenantId)));
    }

    function isMember(tenantId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/tenantMembers/$(memberId(tenantId))) &&
        memberDoc(tenantId).data.status == 'active';
    }

    function memberRole(tenantId) {
      return memberDoc(tenantId).data.role;
    }

    // Роль внутри заведения; супер-админу можно всё.
    function hasRole(tenantId, roles) {
      return isSuperAdmin() || (isMember(tenantId) && memberRole(tenantId) in roles);
    }

    // Любой сотрудник заведения (все роли, кроме отсутствия членства).
    function isStaff(tenantId) {
      return hasRole(tenantId, ['owner', 'admin', 'manager', 'employee']);
    }

    // ---- Сети заведений ----
    // Сеть объединяет точки одного владельца: общие подписка, брендинг и
    // лояльность, касса у каждой точки своя. У одиночного заведения chainId
    // нет, chainIdOf() вернёт '' — проверки сетей лишних чтений не делают.
    function chainIdOf(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('chainId', '');
    }

    function chainMemberId(chainId) {
      return chainId + '_' + request.auth.uid;
    }

    function isChainMember(chainId) {
      return chainId != '' && signedIn() &&
        exists(/databases/$(database)/documents/chainMembers/$(chainMemberId(chainId))) &&
        get(/databases/$(database)/documents/chainMembers/$(chainMemberId(chainId))).data.status == 'active';
    }

    function chainMemberRole(chainId) {
      return get(/databases/$(database)/documents/chainMembers/$(chainMemberId(chainId))).data.role;
    }

    function hasChainRole(chainId, roles) {
      return isSuperAdmin() || (isChainMember(chainId) && chainMemberRole(chainId) in roles);
    }

    // Сотрудник любой точки сети: гостевой справочник и баланс у сети общие.
    function isChainStaff(chainId) {
      return hasChainRole(chainId, ['owner', 'admin', 'manager', 'employee']);
    }

    function isChainGuest(chainId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/chains/$(chainId)/clients/$(request.auth.uid));
    }

    // Гость этого заведения — у кого есть профиль clients в его поддереве или
    // в сети. Анонимный вход валиден для любого заведения платформы, так что
    // без этой проверки гость одного заведения читал бы меню и зал другого.
    // Профиль приложение гостя создаёт при запуске, до показа меню.
    function isTenantGuest(tenantId) {
      let cId = chainIdOf(tenantId);
      return signedIn() && (
        exists(/databases/$(database)/documents/tenants/$(tenantId)/clients/$(request.auth.uid)) ||
        (cId != '' && exists(/databases/$(database)/documents/chains/$(cId)/clients/$(request.auth.uid)))
      );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Поля профиля гостя, которые ведёт только касса ----
    // Бонусы, траты, визиты, уровень и скидка карты: гость не может ни
    // поменять их, ни создать профиль сразу с ними.
    function guestProfileCleanOnCreate(d) {
      return d.get('bonusBalance', 0) == 0 &&
        d.get('totalSpent', 0) == 0 &&
        d.get('visits', 0) == 0 &&
        d.get('discountPercent', 0) == 0 &&
        d.get('discountCardId', '') in ['', null] &&
        !('tier' in d);
    }
    function guestProfileCleanOnUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['bonusBalance', 'tier', 'totalSpent', 'visits', 'discountPercent', 'discountCardId']);
    }

    // ---- users: свой профиль читает/правит сам, супер-админ — любой ----
    match /users/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin();
      allow create: if isSelf(uid);
      // email/createdAt не должны переписываться пользователем задним числом.
      allow update: if isSelf(uid) &&
        !('email' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('createdAt' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isSuperAdmin();
    }

    // Первого супер-админа заводят вручную в консоли Firebase, дальше — только
    // через saas-gateway (свежий ввод пароля и запись в securityLog).
    match /superAdmins/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin();
      allow write: if false;
    }

    // ---- Входы в панель и журнал опасных действий: читает супер-админ,
    //      пишет только сервер — из браузера запись не подделать и не стереть.
    match /adminLogins/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /securityLog/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    // Состояние платформы для чек-листа «Безопасность → Платформа»
    // (сертификаты, резервные копии, уведомления об оплате) — пишет сервер.
    match /platformStatus/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    // Регистрации/попытки по IP и блок-лист IP и доменов почты
    // («Безопасность → Активность») — IP не хранится в документе
    // заведения, чтобы его не видели сотрудники заведения.
    match /signupEvents/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /blocklist/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    // Реестр запросов субъектов персональных данных (152-ФЗ): гость
    // отправляет запрос на удаление через saas-gateway, остальное заводит
    // супер-админ — тоже через сервер, чтобы всё попадало в журнал.
    match /dataRequests/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ---- tenants: сам факт существования заведения и его статус ----
    match /tenants/{tenantId} {
      allow read: if isMember(tenantId) || isSuperAdmin();
      // Заведение создаёт только saas-gateway: онбординг, лимиты, биллинг.
      allow create: if false;
      // Статус, подписку, владельца и chainId меняют сервер и супер-админ.
      // Владельцу — только название, списком разрешённых полей, чтобы новое
      // поле не проскочило.
      allow update: if isSuperAdmin() ||
        (hasRole(tenantId, ['owner', 'admin']) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // ---- tenantMembers: кто состоит в заведении и с какой ролью ----
    match /tenantMembers/{id} {
      allow read: if isSuperAdmin() ||
        (signedIn() &&
         (resource.data.userId == request.auth.uid ||
          isMember(resource.data.tenantId)));
      // Владелец и админ выдают и меняют только рядовые роли: owner и admin
      // назначает сервер (биллинг считает совладельцев).
      //
      // Третья ветка — планшет присоединяется сам: код приглашения он уже
      // предъявил, создавая tenants/{tenantId}/devices/{uid}, поэтому может
      // завести себе роль employee, не выше.
      allow create: if isSuperAdmin() ||
        (hasRole(request.resource.data.tenantId, ['owner', 'admin']) &&
         request.resource.data.role in ['manager', 'employee']) ||
        (isSelf(request.resource.data.userId) &&
         request.resource.data.role == 'employee' &&
         request.resource.data.status == 'active' &&
         id == request.resource.data.tenantId + '_' + request.resource.data.userId &&
         exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)/devices/$(request.auth.uid)));
      allow update: if isSuperAdmin() ||
        (hasRole(resource.data.tenantId, ['owner', 'admin']) &&
         resource.data.role in ['manager', 'employee'] &&
         request.resource.data.role in ['manager', 'employee']);
      // Убрать можно только рядового участника — иначе админ удалил бы
      // членство владельца.
      allow delete: if isSuperAdmin() ||
        (hasRole(resource.data.tenantId, ['owner', 'admin']) &&
         resource.data.role in ['manager', 'employee']);
    }

    // ---- chains: сеть и её статус ----
    match /chains/{chainId} {
      allow read: if isChainMember(chainId) || isSuperAdmin();
      // Как и заведение, создаёт только saas-gateway.
      allow create: if false;
      allow update: if isSuperAdmin() ||
        (hasChainRole(chainId, ['owner', 'admin']) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // ---- Реквизиты платформы (оферта, политика ПДн, подвал сайта) —
    //      публичны; меняет только saas-gateway после ввода пароля. ----
    match /platformConfig/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---- chainMembers — как tenantMembers, id = "<chainId>_<uid>". Сервер
    //      дублирует сюда членства точек сети (syncChainMembership); owner
    //      кладёт только он. ----
    match /chainMembers/{id} {
      allow read: if isSuperAdmin() ||
        (signedIn() &&
         (resource.data.userId == request.auth.uid || isChainMember(resource.data.chainId)));
      // Вторая ветка — планшет точки сети сам заводит себе зеркало
      // членства: присоединяется он без сервера (SaasDeviceJoinService), и
      // без этой записи касса точки не видела бы общую лояльность сети.
      // Только employee, только активный участник точки этой сети с
      // документом устройства. Отключённый планшет запись не вернёт: она
      // уже есть, а менять её может только владелец или админ сети.
      allow create: if isSuperAdmin() ||
        (hasChainRole(request.resource.data.chainId, ['owner', 'admin']) &&
         request.resource.data.role in ['manager', 'employee']) ||
        (signedIn() &&
         id == request.resource.data.chainId + '_' + request.auth.uid &&
         request.resource.data.keys().hasOnly(['chainId', 'userId', 'tenantId', 'role', 'status', 'createdAt']) &&
         request.resource.data.userId == request.auth.uid &&
         request.resource.data.role == 'employee' &&
         request.resource.data.status == 'active' &&
         request.resource.data.tenantId is string &&
         request.resource.data.chainId != '' &&
         chainIdOf(request.resource.data.tenantId) == request.resource.data.chainId &&
         isMember(request.resource.data.tenantId) &&
         exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)/devices/$(request.auth.uid)));
      allow update: if isSuperAdmin() ||
        (hasChainRole(resource.data.chainId, ['owner', 'admin']) &&
         resource.data.role in ['manager', 'employee'] &&
         request.resource.data.role in ['manager', 'employee']);
      allow delete: if isSuperAdmin() ||
        (hasChainRole(resource.data.chainId, ['owner', 'admin']) &&
         resource.data.role in ['manager', 'employee']);
    }

    // ---- Брендинг сети — как у заведения: читают все (нужен до входа
    //      гостя), пишут владелец и админ сети. ----
    match /chains/{chainId}/branding/{doc} {
      allow read: if true;
      allow write: if hasChainRole(chainId, ['owner', 'admin']);
    }

    // ---- ИИ сети: один набор ключей на все точки. Как у заведения:
    //      публичная часть без ключей видна гостям, ключи — только персоналу. ----
    match /chains/{chainId}/meta/aiSettings {
      allow read: if isChainStaff(chainId) || isChainGuest(chainId) || isSuperAdmin();
      allow write: if hasChainRole(chainId, ['owner', 'admin']) &&
        !('apiKey' in request.resource.data) &&
        !('vendorKeys' in request.resource.data) &&
        (!('vendors' in request.resource.data) ||
          aiVendorsArePublic(request.resource.data.vendors));
    }
    match /chains/{chainId}/meta/aiSecrets {
      allow read: if isChainStaff(chainId);
      allow write: if hasChainRole(chainId, ['owner', 'admin']);
    }

    // ---- Общая лояльность сети: профиль, баланс и визиты гостя одни на
    //      все точки. Правила повторяют tenants/{tenantId}/clients ниже с
    //      isChainStaff/isChainGuest вместо isStaff/isTenantGuest. ----
    match /chains/{chainId}/clients/{uid} {
      allow read: if isSelf(uid) || isChainStaff(chainId);

      // В пути нет tenantId, поэтому гость присылает activeTenantId — точку,
      // где он сидит (GuestLinkService.bindToSession). Проверяем sessionClaims
      // этой точки и что она правда в этой сети.
      function chainSessionClaimOk(currentSid) {
        let sid = request.resource.data.get('activeSessionId', '');
        let tid = request.resource.data.get('activeTenantId', '');
        return sid == '' || sid == currentSid ||
          (chainIdOf(tid) == chainId &&
           exists(/databases/$(database)/documents/tenants/$(tid)/sessionClaims/$(sid)) &&
           get(/databases/$(database)/documents/tenants/$(tid)/sessionClaims/$(sid)).data.uid == uid);
      }

      allow create: if isChainStaff(chainId) ||
        (isSelf(uid) && chainSessionClaimOk('') && guestProfileCleanOnCreate(request.resource.data));
      allow update: if isChainStaff(chainId) ||
        (isSelf(uid) &&
         chainSessionClaimOk(resource.data.get('activeSessionId', '')) &&
         (!('phone' in request.resource.data) ||
          resource.data.get('phone', '') == '' ||
          request.resource.data.phone == resource.data.phone) &&
         guestProfileCleanOnUpdate());
      allow delete: if isChainStaff(chainId);
    }

    match /chains/{chainId}/clients/{uid}/visits/{visitId} {
      allow read: if isSelf(uid) || isChainStaff(chainId);
      allow write: if isChainStaff(chainId);
    }

    match /chains/{chainId}/phoneIndex/{phone} {
      allow read: if isChainStaff(chainId) || isChainGuest(chainId);
      allow create: if isChainStaff(chainId) ||
        (isChainGuest(chainId) && request.resource.data.uid == request.auth.uid);
      allow update: if isChainStaff(chainId) ||
        (isChainGuest(chainId) &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isChainStaff(chainId);
    }

    match /chains/{chainId}/referralCodes/{code} {
      allow read: if isChainStaff(chainId) || isChainGuest(chainId);
      allow create: if isChainStaff(chainId) ||
        (isChainGuest(chainId) && request.resource.data.uid == request.auth.uid);
      allow update: if isChainStaff(chainId) ||
        (isChainGuest(chainId) &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isChainStaff(chainId);
    }

    match /chains/{chainId}/bonusOperations/{doc} {
      allow read: if isChainStaff(chainId) ||
        (isChainGuest(chainId) && resource.data.clientUid == request.auth.uid);
      allow write: if isChainStaff(chainId);
    }

    // ---- Настройки заведения ----
    // Правила на один путь складываются через ИЛИ, поэтому исключение для
    // deviceInvite живёт внутри общего правила, а не отдельным match.
    //
    // deviceInvite — секретный код приглашения устройства: перевыпускают его
    // только владелец и админ, иначе сотрудник приглашал бы устройства в
    // обход владельца. Остальные settings/* пишет любой сотрудник: планшет
    // кассы в Firestore всегда employee (роли различаются PIN-кодом внутри
    // приложения), и с owner/admin ни одна настройка с кассы не сохранилась
    // бы.
    match /tenants/{tenantId}/settings/{doc} {
      // Супер-админ читает для поддержки из панели платформы.
      allow read: if isMember(tenantId) || isSuperAdmin();
      allow write: if doc == 'deviceInvite'
        ? hasRole(tenantId, ['owner', 'admin'])
        : isStaff(tenantId);
    }
    // Уровни и кешбэк лояльности читает и гость: это его процент в профиле.
    match /tenants/{tenantId}/settings/loyalty {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }

    // ---- Заметки супер-админа о заведении — владельцу не видны ----
    match /tenants/{tenantId}/internal/{doc} {
      allow read, write: if isSuperAdmin();
    }

    // ---- Брендинг ----
    match /tenants/{tenantId}/branding/{doc} {
      // Публично: страница стола показывает название и цвета ещё до
      // анонимного входа. Это не секрет — то же видно в скачиваемом APK.
      allow read: if true;
      allow write: if hasRole(tenantId, ['owner', 'admin']);
    }

    // ---- Устройства кассы ----
    // Присоединяются по коду приглашения своего заведения, а не по общему
    // секрету платформы — иначе чужой код открывал бы все заведения.
    match /tenants/{tenantId}/devices/{deviceId} {
      allow read: if isMember(tenantId);
      allow create: if isSelf(deviceId) &&
        request.resource.data.inviteCode ==
          get(/databases/$(database)/documents/tenants/$(tenantId)/settings/deviceInvite).data.code;
      allow update, delete: if hasRole(tenantId, ['owner', 'admin']);
    }

    // ---- Сотрудники (PIN-вход на кассе) ----
    // isStaff, а не owner/admin: сотрудников и зарплату настраивают с
    // планшета, а он в Firestore всегда employee.
    match /tenants/{tenantId}/employees/{employeeId} {
      allow read: if isStaff(tenantId);
      allow write: if isStaff(tenantId);
    }

    // ---- Столы и чеки ----
    match /tenants/{tenantId}/tables/{doc} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }

    // Чек гостя. У гостя сети профиль лежит в chains/{chainId}/clients, а
    // чек — в конкретной точке, поэтому сверяем и activeTenantId.
    function myActiveSession(tenantId) {
      let cId = chainIdOf(tenantId);
      return cId == ''
        ? get(/databases/$(database)/documents/tenants/$(tenantId)/clients/$(request.auth.uid)).data.activeSessionId
        : (get(/databases/$(database)/documents/chains/$(cId)/clients/$(request.auth.uid)).data.get('activeTenantId', '') == tenantId
            ? get(/databases/$(database)/documents/chains/$(cId)/clients/$(request.auth.uid)).data.activeSessionId
            : '');
    }

    match /tenants/{tenantId}/sessions/{doc} {
      allow read: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && myActiveSession(tenantId) == doc);
      allow update: if isStaff(tenantId) ||
        (signedIn() &&
         exists(/databases/$(database)/documents/tenants/$(tenantId)/sessionClaims/$(doc)) &&
         get(/databases/$(database)/documents/tenants/$(tenantId)/sessionClaims/$(doc)).data.uid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestTag']));
      allow create, delete: if isStaff(tenantId);
    }

    // ---- Витрина: меню ----
    match /tenants/{tenantId}/menuCategories/{doc} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/menuItems/{doc} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }

    // ---- Профили гостей заведения ----
    match /tenants/{tenantId}/clients/{uid} {
      allow read: if isSelf(uid) || isStaff(tenantId);

      function sessionClaimOk(currentSid) {
        let sid = request.resource.data.get('activeSessionId', '');
        return sid == '' || sid == currentSid ||
          (exists(/databases/$(database)/documents/tenants/$(tenantId)/sessionClaims/$(sid)) &&
           get(/databases/$(database)/documents/tenants/$(tenantId)/sessionClaims/$(sid)).data.uid == uid);
      }

      allow create: if isStaff(tenantId) ||
        (isSelf(uid) && sessionClaimOk('') && guestProfileCleanOnCreate(request.resource.data));
      allow update: if isStaff(tenantId) ||
        (isSelf(uid) &&
         sessionClaimOk(resource.data.get('activeSessionId', '')) &&
         (!('phone' in request.resource.data) ||
          resource.data.get('phone', '') == '' ||
          request.resource.data.phone == resource.data.phone) &&
         guestProfileCleanOnUpdate());
      allow delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/clients/{uid}/visits/{visitId} {
      allow read: if isSelf(uid) || isStaff(tenantId);
      allow write: if isStaff(tenantId);
    }

    // ---- Указатели «номер/код → uid» (обезличены, без query по clients) ----
    match /tenants/{tenantId}/phoneIndex/{phone} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow create: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && request.resource.data.uid == request.auth.uid);
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/referralCodes/{code} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow create: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && request.resource.data.uid == request.auth.uid);
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/sessionClaims/{sessionId} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow create: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && request.resource.data.uid == request.auth.uid);
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && resource.data.uid == request.auth.uid);
    }

    // ---- Брони ----
    match /tenants/{tenantId}/reservations/{doc} {
      allow read: if isStaff(tenantId) || (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         request.resource.data.clientUid == request.auth.uid &&
         request.resource.data.status == 'new' &&
         request.resource.data.get('sessionId', '') == '' &&
         request.resource.data.get('preOrder', []) is list &&
         request.resource.data.get('preOrder', []).size() <= 50);
      // Гость может только отменить ещё не состоявшуюся бронь (не ту, где
      // он уже за столом или отмечен «не пришёл») или ответить «приду» —
      // и ничего больше в ней не менять.
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.clientUid == request.auth.uid &&
         ((request.resource.data.status == 'cancelled' &&
           resource.data.status in ['new', 'confirmed'] &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'handledBy'])) ||
          (request.resource.data.status == resource.data.status &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['guestConfirmed']))));
      allow delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/reservationSlots/{doc} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow create: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && request.resource.data.clientUid == request.auth.uid);
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.clientUid == request.auth.uid &&
         request.resource.data.clientUid == request.auth.uid);
      allow delete: if isStaff(tenantId);
    }

    // ---- Вызовы персонала, заказы, отзывы, чаевые, очередь ----
    match /tenants/{tenantId}/waiterCalls/{doc} {
      allow read: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isTenantGuest(tenantId) && request.resource.data.clientUid == request.auth.uid;
      allow update, delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/guestOrders/{doc} {
      allow read: if isStaff(tenantId) || (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      // Цены из заказа касса не берёт (пересчитывает по меню), но
      // бесконечный список позиций ронял бы очередь заказов на кассе.
      allow create: if isTenantGuest(tenantId) &&
        request.resource.data.clientUid == request.auth.uid &&
        request.resource.data.status == 'new' &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 50;
      allow update, delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/reviews/{doc} {
      allow read: if isStaff(tenantId) || (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isTenantGuest(tenantId) && request.resource.data.clientUid == request.auth.uid;
      allow update, delete: if isStaff(tenantId);
    }

    // Чаевые: гость создаёт только свои и только «ожидают оплаты» — оплату
    // отмечает касса. Сумма ограничена, чтобы опечатка «50000» вместо «500»
    // не повисла на счёте. Отменить гость может только свои неоплаченные.
    match /tenants/{tenantId}/tips/{doc} {
      allow read: if isStaff(tenantId) || (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isStaff(tenantId) || (isTenantGuest(tenantId) &&
        request.resource.data.clientUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.amount <= 100000);
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.clientUid == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']));
      allow delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/waitlist/{doc} {
      allow read: if isStaff(tenantId) || (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isTenantGuest(tenantId) &&
        request.resource.data.clientUid == request.auth.uid &&
        request.resource.data.status == 'waiting';
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.clientUid == request.auth.uid &&
         request.resource.data.status == 'left');
      allow delete: if isStaff(tenantId);
    }

    // ---- Бонусы: пишет только касса ----
    match /tenants/{tenantId}/bonusOperations/{doc} {
      allow read: if isStaff(tenantId) || (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow write: if isStaff(tenantId);
    }

    // ---- Сертификаты ----
    match /tenants/{tenantId}/giftCards/{code} {
      allow get: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow list: if isStaff(tenantId);
      allow write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/giftCardClaims/{doc} {
      allow read: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isTenantGuest(tenantId) &&
        request.resource.data.clientUid == request.auth.uid &&
        request.resource.data.status == 'new' &&
        request.resource.data.amount == 0;
      allow update, delete: if isStaff(tenantId);
    }

    // ---- Афиша, счастливые часы, профиль/правила заведения (витрина) ----
    match /tenants/{tenantId}/stories/{doc} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/happyHours/{doc} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }
    // Профиль заведения правят на кассе под PIN администратора, а планшет в
    // Firestore — employee, поэтому isStaff.
    match /tenants/{tenantId}/meta/venueProfile {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }
    // Кто сейчас на смене — имена, должности и ссылки для чаевых. Гость
    // выбирает из них, кому оставить чаевые; сотрудников и смены целиком
    // (PIN, ставки) он по-прежнему не видит. Ведёт касса.
    match /tenants/{tenantId}/meta/tipsTeam {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }
    // Настройки провайдеров в публичном документе — без ключей и адресов.
    function aiVendorPublic(v, id) {
      return !(id in v) ||
        (v[id] is map && !('apiKey' in v[id]) && !('baseUrl' in v[id]));
    }
    function aiVendorsArePublic(v) {
      return v is map &&
        v.keys().hasOnly(['tooken', 'darkapi', 'gemini', 'custom']) &&
        aiVendorPublic(v, 'tooken') && aiVendorPublic(v, 'darkapi') &&
        aiVendorPublic(v, 'gemini') && aiVendorPublic(v, 'custom');
    }
    // Публичная часть настроек ИИ — её читает и приложение гостя, поэтому
    // ключей здесь быть не может. Ключи — в meta/aiSecrets.
    match /tenants/{tenantId}/meta/aiSettings {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if hasRole(tenantId, ['owner', 'admin']) &&
        !('apiKey' in request.resource.data) &&
        !('vendorKeys' in request.resource.data) &&
        (!('vendors' in request.resource.data) ||
          aiVendorsArePublic(request.resource.data.vendors));
    }
    // Ключи и адреса провайдеров ИИ: только персонал (POS вызывает ИИ
    // напрямую). Гостевое приложение ходит через шлюз /aiProxy.
    match /tenants/{tenantId}/meta/aiSecrets {
      allow read: if isStaff(tenantId);
      allow write: if hasRole(tenantId, ['owner', 'admin']);
    }
    // Остальные meta/* — поимённо: общий meta/{doc} открыл бы и aiSettings.
    match /tenants/{tenantId}/meta/jobsLock {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/meta/aiSchedulerLock {
      allow read, write: if isStaff(tenantId);
    }

    // ---- Аудит и служебные журналы: только персонал своего заведения ----
    match /tenants/{tenantId}/auditLog/{doc} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId);
      allow update, delete: if false;
    }
    // Пишут касса и гость этого заведения, не любой вошедший в проект.
    match /tenants/{tenantId}/aiLogs/{doc} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow update, delete: if isStaff(tenantId);
    }
    // Действия ИИ-ассистента (журнал «Активность»). Гость пишет только свои,
    // с scope: 'guest' и своим uid, — не выдать себя за персонал.
    match /tenants/{tenantId}/aiActions/{doc} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         request.resource.data.get('scope', '') == 'guest' &&
         request.resource.data.get('guestUid', '') == request.auth.uid);
      allow update, delete: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/staffNotes/{doc} {
      allow read, write: if isStaff(tenantId);
    }

    // ---- Журнал платформы (жизненный цикл заведений, действия супер-админа) ----
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() ||
        (signedIn() && hasRole(resource.data.tenantId, ['owner', 'admin']));
      // Пишет только сервер.
      allow write: if false;
    }

    // ---- Обращения в поддержку: владелец и админ своего заведения и
    //      супер-админ. Создать — только на своё заведение и от своего имени. ----
    match /supportTickets/{ticketId} {
      allow read: if hasRole(resource.data.tenantId, ['owner', 'admin']);
      allow create: if hasRole(request.resource.data.tenantId, ['owner', 'admin']) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == 'open';
      allow update: if hasRole(resource.data.tenantId, ['owner', 'admin']);

      match /messages/{messageId} {
        allow read: if hasRole(
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.tenantId,
          ['owner', 'admin']);
        allow create: if hasRole(
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.tenantId,
          ['owner', 'admin']) && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---- Суточные снимки метрик платформы (регистрации, MRR) — финансы
    //      всей платформы, видит только супер-админ. ----
    match /platformMetrics/{dateId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ---- Тарифы: цены показываем на лендинге до регистрации; меняет
    //      только сервер, с записью «было → стало» в журнал. ----
    match /plans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Объявления платформы: баннер в кабинете, пишет супер-админ ----
    match /broadcasts/{broadcastId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // ---- Подписки: читает любой участник заведения или сети — касса на
    //      каждом планшете (роль employee) проверяет статус подписки. У сети
    //      документ subscriptions/{chainId} с полем chainId. ----
    match /subscriptions/{subscriptionId} {
      allow read: if isSuperAdmin() ||
        (resource.data.get('tenantId', null) != null && isMember(resource.data.tenantId)) ||
        (resource.data.get('chainId', null) != null && isChainMember(resource.data.chainId));
      // Пишет только сервер: оплаты, триал, продление и ручная правка.
      allow write: if false;
    }

    // ---- Уведомления об оплате: защита от повторной обработки и история
    //      платежей владельца. Пишет только сервер. ----
    match /billingEvents/{paymentId} {
      allow read: if isSuperAdmin() ||
        (signedIn() && resource.data.tenantId != null && hasRole(resource.data.tenantId, ['owner', 'admin']));
      allow write: if false;
    }

    // ---- Счета для ИП и организаций: владелец и админ заведения или сети,
    //      супер-админ. Пишет только сервер. ----
    match /bankInvoices/{invoiceId} {
      allow read: if isSuperAdmin() ||
        (signedIn() && resource.data.tenantId != null && hasRole(resource.data.tenantId, ['owner', 'admin'])) ||
        (signedIn() && resource.data.chainId != null && hasChainRole(resource.data.chainId, ['owner', 'admin']));
      allow write: if false;
    }

    // ---- Сборки APK: запускает сервер (проверяет подписку и лимиты),
    //      собирает GitHub Actions. ----
    match /buildJobs/{buildId} {
      allow read: if isSuperAdmin() ||
        (signedIn() && hasRole(resource.data.tenantId, ['owner', 'admin']));
      allow create: if false;
      allow update, delete: if isSuperAdmin();
    }

    // ---- Счётчики для лимитов тарифа — сервер пересчитывает раз в сутки ----
    match /tenants/{tenantId}/usage/{doc} {
      allow read: if isSuperAdmin() || hasRole(tenantId, ['owner', 'admin']);
      allow write: if false;
    }

    // ---- Остальные рабочие коллекции заведения ----
    // Общего match /tenants/{tenantId}/{document=**} намеренно нет: правила
    // складываются через ИЛИ, и такой catch-all с isStaff открыл бы
    // сотруднику брендинг, устройства и код приглашения. Каждая коллекция —
    // поимённо; тест «Каждая коллекция, которой пользуется касса» ловит
    // забытые.
    match /tenants/{tenantId}/inventory/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    // Склад кассы (lib/services/firestore_service.dart).
    match /tenants/{tenantId}/inventoryItems/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    // Отметки фоновых задач кассы (авто-неявка броней, дни рождения,
    // перенос индексов гостей) — чтобы одна задача не выполнялась дважды.
    match /tenants/{tenantId}/jobRuns/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/inventoryMovements/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/inventoryCounts/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/discountCards/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/shifts/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    // Личные смены сотрудников (часы и зарплата) — не кассовые shifts.
    match /tenants/{tenantId}/staffShifts/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    // Указатели открытой смены. Транзакция открытия смены читает их вместе
    // с shifts/staffShifts и проходит, только если разрешены все операции.
    match /tenants/{tenantId}/meta/shiftState {
      allow read, write: if isStaff(tenantId);
    }
    // Наличные в кассе: инкассации, внесения, выплаты, возвраты (см.
    // lib/models/cash_op.dart). Операции не удаляются и не правятся —
    // ошибочную только отменяют флагом, и она остаётся в истории.
    match /tenants/{tenantId}/cashOps/{opId} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId)
        && request.resource.data.type in ['collection', 'deposit', 'payout', 'refund']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount < 100000000
        && request.resource.data.cancelled == false
        && request.resource.data.shiftId is string;
      allow update: if isStaff(tenantId)
        && resource.data.cancelled == false
        && request.resource.data.cancelled == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['cancelled', 'cancelledBy', 'cancelledAt']);
      allow delete: if false;
    }
    match /tenants/{tenantId}/meta/staffShiftState {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/marking_codes_sold/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/aiJobs/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    // Счётчик обращений гостя к ИИ — ведёт сервер (/aiProxy).
    match /tenants/{tenantId}/aiUsage/{doc} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    // Очередь push для Cloud Function sendQueuedPush. На платформе функций
    // нет и приложения сюда не пишут (cloudFunctionsEnabled), но если
    // включат — гость может только позвать персонал (топики staff*), а не
    // разослать текст гостям или на чужое устройство.
    match /tenants/{tenantId}/pushQueue/{doc} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         request.resource.data.get('topic', '') is string &&
         request.resource.data.get('topic', '').matches('staff(-[A-Za-z0-9_-]+)*') &&
         !('token' in request.resource.data) &&
         !('clientUid' in request.resource.data) &&
         request.resource.data.get('title', '') is string &&
         request.resource.data.get('title', '').size() <= 120 &&
         request.resource.data.get('body', '') is string &&
         request.resource.data.get('body', '').size() <= 500);
      allow update, delete: if false;
    }
  }
}
