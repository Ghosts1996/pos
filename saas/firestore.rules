rules_version = '2';

// Правила SaaS-платформы Hookah POS — multi-tenant.
//
// Живёт ОТДЕЛЬНО от корневого firestore.rules, который обслуживает
// одно действующее заведение (проект hoocah-pos) и его трогать нельзя.
// Этот файл разворачивается в НОВЫЙ Firebase-проект (см. saas/README.md).
//
// Модель идентичности:
//   • users/{uid}            — SaaS-аккаунт человека (владелец/сотрудник),
//                               настоящий Firebase Auth (email+password —
//                               НЕ анонимный, в отличие от гостей).
//   • superAdmins/{uid}      — маркер: этот uid управляет платформой
//                               целиком, а не одним заведением. Документ
//                               создаётся только вручную из консоли
//                               Firebase при бутстрапе платформы — ни один
//                               клиентский путь не может создать себе такую
//                               запись.
//   • tenants/{tenantId}     — заведение-клиент SaaS.
//   • tenantMembers/{id}     — членство: id = "<tenantId>_<uid>", одно
//                               членство на пару (пользователь, заведение).
//                               Роль хранится тут, а не в users — так один
//                               и тот же человек может быть admin в одном
//                               заведении и employee в другом.
//   • tenants/{tenantId}/... — все рабочие данные заведения (столы, чеки,
//                               меню, гости и т.д.) — вложены под tenantId,
//                               поэтому изоляция арендаторов проверяется
//                               ОДНИМ способом во всех этих коллекциях:
//                               "состоит ли текущий пользователь в
//                               tenantMembers этого tenantId".
//
// Гости (посетители заведения через QR/веб) по-прежнему анонимны — им
// членство не нужно, они получают доступ к узкому набору документов внутри
// tenants/{tenantId}/... по тем же принципам, что и в исходном приложении
// (видят только свой чек, свой профиль, свои брони и т.д.), просто путь
// теперь на один уровень вложенности глубже.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ---- Платформенный супер-админ ----
    // Супер-админ — и его сеанс не завершён кнопкой «Выйти на всех
    // устройствах» (sessionsValidAfter, секунды; ставит только
    // saas-gateway, см. handleRevokeAdminSessions): без этой проверки уже
    // выданный токен продолжал бы открывать панель ещё до часа.
    function isSuperAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid)) &&
        adminSessionFresh(get(/databases/$(database)/documents/superAdmins/$(request.auth.uid)).data);
    }

    function adminSessionFresh(sa) {
      return !('sessionsValidAfter' in sa) || request.auth.token.auth_time > sa.sessionsValidAfter;
    }

    // ---- Членство в заведении ----
    function memberId(tenantId) {
      return tenantId + '_' + request.auth.uid;
    }

    function memberDoc(tenantId) {
      return get(/databases/$(database)/documents/tenantMembers/$(memberId(tenantId)));
    }

    function isMember(tenantId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/tenantMembers/$(memberId(tenantId))) &&
        memberDoc(tenantId).data.status == 'active';
    }

    function memberRole(tenantId) {
      return memberDoc(tenantId).data.role;
    }

    // roles — список строк, например ['owner','admin']. Супер-админ
    // платформы проходит через isMember() тоже, потому что владеет
    // "правом делать что угодно" — но здесь именно проверка РОЛИ внутри
    // заведения, поэтому супер-админа явно добавляем отдельным условием.
    function hasRole(tenantId, roles) {
      return isSuperAdmin() || (isMember(tenantId) && memberRole(tenantId) in roles);
    }

    // Любой сотрудник заведения (все роли, кроме отсутствия членства).
    function isStaff(tenantId) {
      return hasRole(tenantId, ['owner', 'admin', 'manager', 'employee']);
    }

    // ---- Сети заведений (chains) ----
    //
    // Сеть — необязательная группировка нескольких tenants одного владельца:
    // общий биллинг и общая программа лояльности на все точки, при этом
    // каждая точка сохраняет свою кассу (столы/сотрудники/устройства/чеки)
    // без изменений. Одиночное заведение НИЧЕГО не знает о сетях: у него
    // просто нет поля chainId, chainIdOf() для него возвращает '', и
    // короткое замыкание (||/&&) в isTenantGuest/myActiveSession ниже ни
    // разу не обращается к коллекциям chains/* — то есть для существующих
    // одиночных заведений это ровно ноль дополнительных чтений и ровно
    // прежнее поведение.
    function chainIdOf(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('chainId', '');
    }

    function chainMemberId(chainId) {
      return chainId + '_' + request.auth.uid;
    }

    function isChainMember(chainId) {
      return chainId != '' && signedIn() &&
        exists(/databases/$(database)/documents/chainMembers/$(chainMemberId(chainId))) &&
        get(/databases/$(database)/documents/chainMembers/$(chainMemberId(chainId))).data.status == 'active';
    }

    function chainMemberRole(chainId) {
      return get(/databases/$(database)/documents/chainMembers/$(chainMemberId(chainId))).data.role;
    }

    function hasChainRole(chainId, roles) {
      return isSuperAdmin() || (isChainMember(chainId) && chainMemberRole(chainId) in roles);
    }

    // Сотрудник ЛЮБОЙ точки сети — нужен для общего гостевого справочника
    // (chains/{chainId}/clients и соседние коллекции ниже), который
    // сотрудник одной точки должен видеть точно так же, как и другой:
    // баланс/уровень гостя единый на всю сеть, а не только на ту точку,
    // где гость сейчас сидит.
    function isChainStaff(chainId) {
      return hasChainRole(chainId, ['owner', 'admin', 'manager', 'employee']);
    }

    function isChainGuest(chainId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/chains/$(chainId)/clients/$(request.auth.uid));
    }

    // Гость ЭТОГО заведения — определяется не самим фактом входа в Firebase
    // (в мультитенантном проекте один и тот же анонимный аккаунт гостя
    // валиден для ЛЮБОГО заведения на платформе), а наличием собственного
    // профиля clients в поддереве именно этого tenantId. Такой профиль
    // создаётся первым делом при запуске гостевого приложения/веб-версии
    // (ensureProfile/ensureGuest), до того как экран показывает меню, зал
    // или афишу — поэтому к моменту любого такого чтения профиль уже есть.
    //
    // Без этой проверки было бы достаточно просто быть авторизованным (а
    // авторизован в проекте платформы КАЖДЫЙ гость КАЖДОГО заведения), чтобы
    // читать меню, зал и афишу чужого заведения — прямое нарушение раздела
    // 9 ТЗ ("данные Tenant A никогда не должны быть доступны Tenant B").
    function isTenantGuest(tenantId) {
      let cId = chainIdOf(tenantId);
      return signedIn() && (
        exists(/databases/$(database)/documents/tenants/$(tenantId)/clients/$(request.auth.uid)) ||
        (cId != '' && exists(/databases/$(database)/documents/chains/$(cId)/clients/$(request.auth.uid)))
      );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- users: свой профиль читает/правит сам, супер-админ — любой ----
    match /users/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin();
      allow create: if isSelf(uid);
      // email/createdAt не должны переписываться пользователем задним числом.
      allow update: if isSelf(uid) &&
        !('email' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('createdAt' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isSuperAdmin();
    }

    // Самого первого супер-админа заводит только консоль Firebase (вручную,
    // при бутстрапе платформы). Дальше супер-админы назначают и снимают
    // друг друга только через saas-gateway (handleGrantSuperAdmin/
    // handleRevokeSuperAdmin): там проверяется, что пароль введён только
    // что, и каждое изменение пишется в securityLog. Прямая запись отсюда
    // закрыта — раньше любой открытый сеанс супер-админа (забытый на чужом
    // устройстве, украденный токен) мог назначить кого угодно в обход окна
    // пароля, которое было только в браузере.
    match /superAdmins/{uid} {
      allow read: if isSelf(uid) || isSuperAdmin();
      allow write: if false;
    }

    // ---- Безопасность платформы: входы в панель (adminLogins) и журнал
    //      чувствительных действий (securityLog). Читает только
    //      супер-админ, пишет только saas-gateway (Admin SDK) — запись
    //      журнала нельзя подделать или стереть из браузера. ----
    match /adminLogins/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /securityLog/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    // Состояние платформы для чек-листа «Безопасность → Платформа»
    // (сертификаты, резервные копии, уведомления ЮKassa) — пишет сервер.
    match /platformStatus/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    // Регистрации/попытки по IP и блок-лист IP и доменов почты
    // («Безопасность → Активность») — IP не хранится в документе
    // заведения, чтобы его не видели сотрудники заведения.
    match /signupEvents/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /blocklist/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    // Реестр запросов субъектов персональных данных (152-ФЗ): гость
    // отправляет запрос на удаление через saas-gateway, остальное заводит
    // супер-админ — тоже через сервер, чтобы всё попадало в журнал.
    match /dataRequests/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ---- tenants: сам факт существования заведения и его статус ----
    match /tenants/{tenantId} {
      allow read: if isMember(tenantId) || isSuperAdmin();
      // Создание нового tenant — привилегированная операция. Клиент НЕ
      // создаёт tenant напрямую: это делает Cloud Function createTenant
      // (см. saas/functions/index.js), которая работает от имени admin SDK
      // и не подчиняется этим правилам вовсе. Прямая запись из приложения
      // запрещена, чтобы никто не мог завести себе tenant в обход
      // онбординга/лимитов/биллинга.
      allow create: if false;
      // Статус/подписку/владельца/chainId (см. chains/{chainId} выше)
      // меняет либо супер-админ, либо Cloud Function биллинга (тоже вне
      // правил) — включение точки в сеть/выключение из неё намеренно
      // такая же привилегированная операция, как и создание самого tenant.
      // Обычный owner/admin может менять только некритичные поля (name) —
      // проверено явно, а не "всё, кроме…", чтобы новое опасное поле не
      // проскочило по забывчивости.
      allow update: if isSuperAdmin() ||
        (hasRole(tenantId, ['owner', 'admin']) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // ---- tenantMembers: кто состоит в заведении и с какой ролью ----
    match /tenantMembers/{id} {
      allow read: if isSuperAdmin() ||
        (signedIn() &&
         (resource.data.userId == request.auth.uid ||
          isMember(resource.data.tenantId)));
      // Добавление/смена роли сотрудника — на бэкенде (Cloud Function),
      // либо владельцем/админом заведения для рядовых ролей. Владелец не
      // может назначить второго owner сам себе в обход биллинга (лимит
      // тарифа на число совладельцев считает функция), поэтому роль
      // 'owner' тут запрещена клиенту явно.
      //
      // Третья ветка — самостоятельное присоединение ПЛАНШЕТА: устройство
      // уже прошло проверку кода приглашения при создании своего документа
      // в tenants/{tenantId}/devices/{uid} (см. правило ниже) — раз тот
      // документ существует, повторно спрашивать код не нужно, и устройство
      // может завести себе БАЗОВУЮ роль employee (не выше) для того же uid.
      allow create: if isSuperAdmin() ||
        (hasRole(request.resource.data.tenantId, ['owner', 'admin']) &&
         request.resource.data.role in ['manager', 'employee']) ||
        (isSelf(request.resource.data.userId) &&
         request.resource.data.role == 'employee' &&
         request.resource.data.status == 'active' &&
         id == request.resource.data.tenantId + '_' + request.resource.data.userId &&
         exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)/devices/$(request.auth.uid)));
      allow update: if isSuperAdmin() ||
        (hasRole(resource.data.tenantId, ['owner', 'admin']) &&
         resource.data.role in ['manager', 'employee'] &&
         request.resource.data.role in ['manager', 'employee']);
      allow delete: if isSuperAdmin() ||
        hasRole(resource.data.tenantId, ['owner', 'admin']);
    }

    // ---- chains: сам факт существования сети и её статус (биллинг) ----
    match /chains/{chainId} {
      allow read: if isChainMember(chainId) || isSuperAdmin();
      // Как и tenants выше — создаёт только Cloud Function/шлюз биллинга
      // (admin SDK, createChain в saas-gateway), не клиент напрямую.
      allow create: if false;
      allow update: if isSuperAdmin() ||
        (hasChainRole(chainId, ['owner', 'admin']) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']));
      allow delete: if isSuperAdmin();
    }

    // ---- chainMembers: кто состоит в сети и с какой ролью — тот же формат,
    //      что и tenantMembers (id = "<chainId>_<uid>"). Пишется зеркально
    //      при создании/изменении tenantMembers для точки, у которой задан
    //      chainId (см. syncChainMembership в saas/console/console.js,
    //      saas-gateway/server.js и saas_device_join_service.dart) — роль
    //      'owner' сюда, как и в tenantMembers, может положить только
    //      admin SDK при создании сети/точки. ----
    match /chainMembers/{id} {
      allow read: if isSuperAdmin() ||
        (signedIn() &&
         (resource.data.userId == request.auth.uid || isChainMember(resource.data.chainId)));
      allow create: if isSuperAdmin() ||
        (hasChainRole(request.resource.data.chainId, ['owner', 'admin']) &&
         request.resource.data.role in ['manager', 'employee']);
      allow update: if isSuperAdmin() ||
        (hasChainRole(resource.data.chainId, ['owner', 'admin']) &&
         resource.data.role in ['manager', 'employee'] &&
         request.resource.data.role in ['manager', 'employee']);
      allow delete: if isSuperAdmin() || hasChainRole(resource.data.chainId, ['owner', 'admin']);
    }

    // ---- Брендинг сети — тот же принцип, что и tenants/{tenantId}/branding
    //      ниже: публично читаемо (не секрет, нужно ДО входа гостя), пишет
    //      только владелец/админ сети. Показывается в едином гостевом
    //      приложении сети вместо брендинга отдельной точки, чтобы тема не
    //      "мигала" при переключении гостем точки внутри одной сети. ----
    match /chains/{chainId}/branding/{doc} {
      allow read: if true;
      allow write: if hasChainRole(chainId, ['owner', 'admin']);
    }

    // ---- ИИ сети: один набор ключей и настроек на все точки (владелец
    //      покупает API один раз). Тот же принцип, что у заведения (см.
    //      tenants/{tenantId}/meta/aiSettings ниже): публичная часть без
    //      ключей видна гостям сети, ключи — только персоналу точек. ----
    match /chains/{chainId}/meta/aiSettings {
      allow read: if isChainStaff(chainId) || isChainGuest(chainId) || isSuperAdmin();
      allow write: if hasChainRole(chainId, ['owner', 'admin']) &&
        !('apiKey' in request.resource.data) &&
        !('vendorKeys' in request.resource.data) &&
        (!('vendors' in request.resource.data) ||
          aiVendorsArePublic(request.resource.data.vendors));
    }
    match /chains/{chainId}/meta/aiSecrets {
      allow read: if isChainStaff(chainId);
      allow write: if hasChainRole(chainId, ['owner', 'admin']);
    }

    // ---- Общая лояльность сети: профиль/баланс/история визитов гостя один
    //      на всю сеть, а не на каждую точку — см. docstring chains/{chainId}
    //      выше. Форма правил намеренно зеркалит tenants/{tenantId}/clients
    //      и соседние коллекции ниже: та же логика, просто isStaff(tenantId)/
    //      isTenantGuest(tenantId) заменены на isChainStaff(chainId)/
    //      isChainGuest(chainId). ----
    match /chains/{chainId}/clients/{uid} {
      allow read: if isSelf(uid) || isChainStaff(chainId);

      // В отличие от tenants/{tenantId}/clients, здесь нельзя напрямую
      // проверить sessionClaims конкретной точки — путь до документа не
      // содержит tenantId. Вместо этого гость обязан прислать activeTenantId
      // (в какой именно точке сети он физически сидит, см. GuestLinkService.
      // bindToSession) — и мы проверяем sessionClaims ИМЕННО этой точки, а
      // заодно что она правда состоит в этой сети (chainIdOf(tid) == chainId),
      // чтобы нельзя было подставить чек чужой точки/сети.
      function chainSessionClaimOk(currentSid) {
        let sid = request.resource.data.get('activeSessionId', '');
        let tid = request.resource.data.get('activeTenantId', '');
        return sid == '' || sid == currentSid ||
          (chainIdOf(tid) == chainId &&
           exists(/databases/$(database)/documents/tenants/$(tid)/sessionClaims/$(sid)) &&
           get(/databases/$(database)/documents/tenants/$(tid)/sessionClaims/$(sid)).data.uid == uid);
      }

      allow create: if isChainStaff(chainId) || (isSelf(uid) && chainSessionClaimOk(''));
      allow update: if isChainStaff(chainId) ||
        (isSelf(uid) &&
         chainSessionClaimOk(resource.data.get('activeSessionId', '')) &&
         (!('phone' in request.resource.data) ||
          resource.data.get('phone', '') == '' ||
          request.resource.data.phone == resource.data.phone) &&
         (!('bonusBalance' in request.resource.data.diff(resource.data).affectedKeys())) &&
         (!('tier' in request.resource.data.diff(resource.data).affectedKeys())) &&
         (!('totalSpent' in request.resource.data.diff(resource.data).affectedKeys())));
      allow delete: if isChainStaff(chainId);
    }

    match /chains/{chainId}/clients/{uid}/visits/{visitId} {
      allow read: if isSelf(uid) || isChainStaff(chainId);
      allow write: if isChainStaff(chainId);
    }

    match /chains/{chainId}/phoneIndex/{phone} {
      allow read: if isChainStaff(chainId) || isChainGuest(chainId);
      allow create: if isChainStaff(chainId) ||
        (isChainGuest(chainId) && request.resource.data.uid == request.auth.uid);
      allow update: if isChainStaff(chainId) ||
        (isChainGuest(chainId) &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isChainStaff(chainId);
    }

    match /chains/{chainId}/referralCodes/{code} {
      allow read: if isChainStaff(chainId) || isChainGuest(chainId);
      allow create: if isChainStaff(chainId) ||
        (isChainGuest(chainId) && request.resource.data.uid == request.auth.uid);
      allow update: if isChainStaff(chainId) ||
        (isChainGuest(chainId) &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isChainStaff(chainId);
    }

    match /chains/{chainId}/bonusOperations/{doc} {
      allow read: if isChainStaff(chainId) ||
        (isChainGuest(chainId) && resource.data.clientUid == request.auth.uid);
      allow write: if isChainStaff(chainId);
    }

    // ---- Настройки заведения ----
    // ВАЖНО про Firestore Security Rules: несколько match-блоков на один и
    // тот же путь объединяются через ИЛИ (доступ есть, если разрешает ХОТЯ
    // БЫ ОДИН применимый блок) — более специфичный путь не "переопределяет"
    // более общий, а лишь ДОБАВЛЯЕТ разрешения. Поэтому исключение для
    // settings/deviceInvite ниже нельзя вынести отдельным match'ем со своим,
    // более строгим write — общий settings/{doc} всё равно продолжил бы его
    // разрешать. Условие приходится держать внутри одного правила.
    //
    // settings/deviceInvite — секретный код приглашения устройства
    // (tenants/{tenantId}/devices выше сверяет его при первом join) —
    // единственный документ в этой коллекции, который МЕНЯТЬ должен только
    // owner/admin: рядовое устройство/сотрудник не должен уметь перевыпустить
    // код (иначе можно самому себе наприглашать сколько угодно устройств в
    // обход владельца).
    //
    // Остальные settings/* (например settings/integrations — редактируется
    // прямо с кассы, lib/screens/admin/integrations_settings_screen.dart) —
    // пишет любой сотрудник заведения, а не только owner/admin: устройство
    // кассы, присоединившееся по коду приглашения, ВСЕГДА получает роль
    // employee в tenantMembers (см. saas_device_join_service.dart —
    // owner/admin там взяться неоткуда, эта роль различается только внутри
    // самого приложения по PIN, а не на уровне Firestore) — то есть
    // hasRole(['owner','admin']) тут был бы физически невыполним ни с одного
    // планшета и такие настройки не сохранялись бы никогда. В одноарендной
    // версии (firestore.rules в корне) все эти данные точно так же пишет
    // любой isStaff() без разделения на роли — здесь то же самое поведение.
    match /tenants/{tenantId}/settings/{doc} {
      // Супер-админ тоже читает — нужно для поддержки клиента из панели
      // платформы без захода в его кабинет.
      allow read: if isMember(tenantId) || isSuperAdmin();
      allow write: if doc == 'deviceInvite'
        ? hasRole(tenantId, ['owner', 'admin'])
        : isStaff(tenantId);
    }
    // Пороги/кешбек программы лояльности (settings/loyalty,
    // lib/screens/admin/loyalty_settings_screen.dart) — читает ещё и
    // ГОСТЬ: это его собственный уровень и процент в профиле (см.
    // ClientProfile.tiers), а isMember() выше про гостя ничего не знает
    // (та проверка — про tenantMembers, вход в консоль/устройство кассы,
    // а не про профиль гостя). Пишет — как и остальные settings/* выше —
    // любой сотрудник заведения (та же причина: с кассы это всегда роль
    // employee на уровне Firestore).
    match /tenants/{tenantId}/settings/loyalty {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }

    // ---- Внутренние заметки супер-админа о заведении (CRM-заметки для
    //      поддержки — кто оплатил вручную, о чём договорились и т.д.) ----
    //      Никогда не видны владельцу/сотрудникам заведения.
    match /tenants/{tenantId}/internal/{doc} {
      allow read, write: if isSuperAdmin();
    }

    // ---- Брендинг ----
    match /tenants/{tenantId}/branding/{doc} {
      // Публично: страница-прослойка QR стола (saas/guest-web/table.html)
      // показывает название и цвета заведения ДО того, как гость вообще
      // вошёл в приложение (анонимный вход ещё не случился в момент показа
      // install-экрана) — обычной проверкой isTenantGuest тут не
      // обойтись без лишнего анонимного аккаунта на каждый заход. Само по
      // себе название и цвет — не секрет (то же самое видно в публично
      // скачиваемом APK), поэтому это единственная коллекция SaaS-правил,
      // открытая совсем без входа.
      allow read: if true;
      allow write: if hasRole(tenantId, ['owner', 'admin']);
    }

    // ---- Рабочие устройства (замена staffDevices) ----
    // Устройство присоединяется к заведению по коду-приглашению
    // (tenants/{tenantId}/settings/deviceInvite.code), а не по общему на
    // всю платформу секрету — иначе угнанный код одного заведения открывал
    // бы доступ к данным всех остальных.
    match /tenants/{tenantId}/devices/{deviceId} {
      allow read: if isMember(tenantId);
      allow create: if isSelf(deviceId) &&
        request.resource.data.inviteCode ==
          get(/databases/$(database)/documents/tenants/$(tenantId)/settings/deviceInvite).data.code;
      allow update, delete: if hasRole(tenantId, ['owner', 'admin']);
    }

    // ---- Сотрудники (PIN-вход внутри заведения, как раньше) ----
    // Пишет любой isStaff(), а не только owner/admin — та же причина, что и
    // у settings/* выше: устройство кассы всегда состоит в tenantMembers с
    // ролью employee (см. saas_device_join_service.dart), поэтому
    // hasRole(['owner','admin']) с планшета невыполним никогда, а именно с
    // планшета и открывают «Сотрудники» → зарплату, чтобы её настроить —
    // с hasRole() сохранение молча падало бы permission-denied на каждом
    // заведении платформы. В одноарендной версии этот экран пишет любой
    // isStaff() без разделения ролей — здесь то же самое.
    match /tenants/{tenantId}/employees/{employeeId} {
      allow read: if isStaff(tenantId);
      allow write: if isStaff(tenantId);
    }

    // ---- Столы и чеки ----
    match /tenants/{tenantId}/tables/{doc} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }

    // Для гостя сети профиль с activeSessionId лежит в chains/{chainId}/
    // clients, а не в tenants/{tenantId}/clients — но сама сессия физически
    // всё равно принадлежит ОДНОЙ конкретной точке (её кассе), поэтому
    // сверяем ещё и activeTenantId в профиле: гость считается "своим" для
    // sessions/{doc} только пока сидит именно в этой точке сети (см.
    // GuestLinkService.bindToSession — пишет activeTenantId вместе с
    // activeSessionId только в режиме сети).
    function myActiveSession(tenantId) {
      let cId = chainIdOf(tenantId);
      return cId == ''
        ? get(/databases/$(database)/documents/tenants/$(tenantId)/clients/$(request.auth.uid)).data.activeSessionId
        : (get(/databases/$(database)/documents/chains/$(cId)/clients/$(request.auth.uid)).data.get('activeTenantId', '') == tenantId
            ? get(/databases/$(database)/documents/chains/$(cId)/clients/$(request.auth.uid)).data.activeSessionId
            : '');
    }

    match /tenants/{tenantId}/sessions/{doc} {
      allow read: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && myActiveSession(tenantId) == doc);
      allow update: if isStaff(tenantId) ||
        (signedIn() &&
         exists(/databases/$(database)/documents/tenants/$(tenantId)/sessionClaims/$(doc)) &&
         get(/databases/$(database)/documents/tenants/$(tenantId)/sessionClaims/$(doc)).data.uid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestTag']));
      allow create, delete: if isStaff(tenantId);
    }

    // ---- Витрина: меню ----
    match /tenants/{tenantId}/menuCategories/{doc} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/menuItems/{doc} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }

    // ---- Профили гостей заведения ----
    match /tenants/{tenantId}/clients/{uid} {
      allow read: if isSelf(uid) || isStaff(tenantId);

      function sessionClaimOk(currentSid) {
        let sid = request.resource.data.get('activeSessionId', '');
        return sid == '' || sid == currentSid ||
          (exists(/databases/$(database)/documents/tenants/$(tenantId)/sessionClaims/$(sid)) &&
           get(/databases/$(database)/documents/tenants/$(tenantId)/sessionClaims/$(sid)).data.uid == uid);
      }

      allow create: if isStaff(tenantId) || (isSelf(uid) && sessionClaimOk(''));
      allow update: if isStaff(tenantId) ||
        (isSelf(uid) &&
         sessionClaimOk(resource.data.get('activeSessionId', '')) &&
         (!('phone' in request.resource.data) ||
          resource.data.get('phone', '') == '' ||
          request.resource.data.phone == resource.data.phone) &&
         (!('bonusBalance' in request.resource.data.diff(resource.data).affectedKeys())) &&
         (!('tier' in request.resource.data.diff(resource.data).affectedKeys())) &&
         (!('totalSpent' in request.resource.data.diff(resource.data).affectedKeys())));
      allow delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/clients/{uid}/visits/{visitId} {
      allow read: if isSelf(uid) || isStaff(tenantId);
      allow write: if isStaff(tenantId);
    }

    // ---- Указатели «номер/код → uid» (обезличены, без query по clients) ----
    match /tenants/{tenantId}/phoneIndex/{phone} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow create: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && request.resource.data.uid == request.auth.uid);
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/referralCodes/{code} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow create: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && request.resource.data.uid == request.auth.uid);
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/sessionClaims/{sessionId} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow create: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && request.resource.data.uid == request.auth.uid);
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && resource.data.uid == request.auth.uid);
    }

    // ---- Брони ----
    match /tenants/{tenantId}/reservations/{doc} {
      allow read: if isStaff(tenantId) || (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         request.resource.data.clientUid == request.auth.uid &&
         request.resource.data.status == 'new');
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.clientUid == request.auth.uid &&
         (request.resource.data.status == 'cancelled' ||
          (request.resource.data.status == resource.data.status &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['guestConfirmed']))));
      allow delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/reservationSlots/{doc} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow create: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && request.resource.data.clientUid == request.auth.uid);
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.clientUid == request.auth.uid &&
         request.resource.data.clientUid == request.auth.uid);
      allow delete: if isStaff(tenantId);
    }

    // ---- Вызовы персонала, заказы, отзывы, чаевые, очередь ----
    match /tenants/{tenantId}/waiterCalls/{doc} {
      allow read: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isTenantGuest(tenantId) && request.resource.data.clientUid == request.auth.uid;
      allow update, delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/guestOrders/{doc} {
      allow read: if isStaff(tenantId) || (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isTenantGuest(tenantId) &&
        request.resource.data.clientUid == request.auth.uid &&
        request.resource.data.status == 'new';
      allow update, delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/reviews/{doc} {
      allow read: if isStaff(tenantId) || (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isTenantGuest(tenantId) && request.resource.data.clientUid == request.auth.uid;
      allow update, delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/tips/{doc} {
      allow read: if isStaff(tenantId) || (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isTenantGuest(tenantId) &&
        request.resource.data.clientUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isStaff(tenantId);
    }

    match /tenants/{tenantId}/waitlist/{doc} {
      allow read: if isStaff(tenantId) || (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isTenantGuest(tenantId) &&
        request.resource.data.clientUid == request.auth.uid &&
        request.resource.data.status == 'waiting';
      allow update: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) &&
         resource.data.clientUid == request.auth.uid &&
         request.resource.data.status == 'left');
      allow delete: if isStaff(tenantId);
    }

    // ---- Бонусы: пишет только касса ----
    match /tenants/{tenantId}/bonusOperations/{doc} {
      allow read: if isStaff(tenantId) || (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow write: if isStaff(tenantId);
    }

    // ---- Сертификаты ----
    match /tenants/{tenantId}/giftCards/{code} {
      allow get: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow list: if isStaff(tenantId);
      allow write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/giftCardClaims/{doc} {
      allow read: if isStaff(tenantId) ||
        (isTenantGuest(tenantId) && resource.data.clientUid == request.auth.uid);
      allow create: if isTenantGuest(tenantId) &&
        request.resource.data.clientUid == request.auth.uid &&
        request.resource.data.status == 'new' &&
        request.resource.data.amount == 0;
      allow update, delete: if isStaff(tenantId);
    }

    // ---- Афиша, счастливые часы, профиль/правила заведения (витрина) ----
    match /tenants/{tenantId}/stories/{doc} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/happyHours/{doc} {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/meta/venueProfile {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if hasRole(tenantId, ['owner', 'admin']);
    }
    // Настройки провайдеров в публичном документе — без ключей и адресов.
    function aiVendorPublic(v, id) {
      return !(id in v) ||
        (v[id] is map && !('apiKey' in v[id]) && !('baseUrl' in v[id]));
    }
    function aiVendorsArePublic(v) {
      return v is map &&
        v.keys().hasOnly(['tooken', 'darkapi', 'gemini', 'custom']) &&
        aiVendorPublic(v, 'tooken') && aiVendorPublic(v, 'darkapi') &&
        aiVendorPublic(v, 'gemini') && aiVendorPublic(v, 'custom');
    }
    // Публичная часть настроек ИИ (включено ли, модели, агенты) — её читает
    // и гостевое приложение. Ключи провайдеров сюда класть НЕЛЬЗЯ: гость
    // (любой, кто вошёл в Kolibri) прочитал бы их. Ключи — в meta/aiSecrets.
    match /tenants/{tenantId}/meta/aiSettings {
      allow read: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow write: if hasRole(tenantId, ['owner', 'admin']) &&
        !('apiKey' in request.resource.data) &&
        !('vendorKeys' in request.resource.data) &&
        (!('vendors' in request.resource.data) ||
          aiVendorsArePublic(request.resource.data.vendors));
    }
    // Ключи и адреса провайдеров ИИ: только персонал (POS вызывает ИИ
    // напрямую). Гостевое приложение ходит через шлюз /aiProxy.
    match /tenants/{tenantId}/meta/aiSecrets {
      allow read: if isStaff(tenantId);
      allow write: if hasRole(tenantId, ['owner', 'admin']);
    }
    // Служебные документы meta/*, не требующие сужения до owner/admin —
    // перечислены явно (а не через meta/{doc}), чтобы не перекрыть более
    // узкие правила venueProfile/aiSettings выше (см. предупреждение про
    // "общий catch-all" в конце файла).
    match /tenants/{tenantId}/meta/jobsLock {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/meta/aiSchedulerLock {
      allow read, write: if isStaff(tenantId);
    }

    // ---- Аудит и служебные журналы: только персонал своего заведения ----
    match /tenants/{tenantId}/auditLog/{doc} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId);
      allow update, delete: if false;
    }
    match /tenants/{tenantId}/aiLogs/{doc} {
      allow read: if isStaff(tenantId);
      allow create: if signedIn();
      allow update, delete: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/aiActions/{doc} {
      allow read: if isStaff(tenantId);
      allow create: if signedIn();
      allow update, delete: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/staffNotes/{doc} {
      allow read, write: if isStaff(tenantId);
    }

    // ---- Платформенный audit log (жизненный цикл tenant, действия
    //      супер-админа) — top-level, с полем tenantId внутри документа.
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() ||
        (signedIn() && hasRole(resource.data.tenantId, ['owner', 'admin']));
      // Пишут только Cloud Functions (admin SDK, вне правил) — клиент
      // не может создать себе запись аудита задним числом или подделать её.
      allow write: if false;
    }

    // ---- Обращения в поддержку (супер-админ #3) — владелец/админ своего
    //      заведения и супер-админ; статус меняет любой из них (закрыть/
    //      переоткрыть), создать может только владелец/админ и только на
    //      своё заведение и от своего имени. ----
    match /supportTickets/{ticketId} {
      allow read: if hasRole(resource.data.tenantId, ['owner', 'admin']);
      allow create: if hasRole(request.resource.data.tenantId, ['owner', 'admin']) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == 'open';
      allow update: if hasRole(resource.data.tenantId, ['owner', 'admin']);

      match /messages/{messageId} {
        allow read: if hasRole(
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.tenantId,
          ['owner', 'admin']);
        allow create: if hasRole(
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.tenantId,
          ['owner', 'admin']) && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---- Дневные снимки метрик платформы (супер-админ #5 — тренд
    //      регистраций/MRR) — пишет только Admin SDK (см.
    //      runCalculatePlatformMetrics в saas-gateway/server.js), видит
    //      только супер-админ: это финансовые данные всей платформы, а не
    //      конкретного заведения. ----
    match /platformMetrics/{dateId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ---- Тарифы (платформенные, читает кто угодно авторизованный —
    //      цену и лимиты нужно показать до создания заведения) ----
    match /plans/{planId} {
      // Публично: цены и лимиты тарифов должны быть видны на лендинге ДО
      // регистрации — как у любого нормального SaaS. Ничего секретного в
      // названии/цене/лимитах тарифа нет.
      allow read: if true;
      // Цены и лимиты меняет только saas-gateway (handleSavePlan/
      // handleDeletePlan) — каждое изменение цены пишется в журнал
      // безопасности с «было → стало».
      allow write: if false;
    }

    // ---- Объявления платформы владельцам (см. панель платформы,
    //      вкладка "Объявления") — читает любой вошедший (баннер на
    //      "Обзоре" личного кабинета), пишет только супер-админ. ----
    match /broadcasts/{broadcastId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    // ---- Подписки: читает любой активный сотрудник заведения (не только
    //      владелец/админ), менять может только биллинговая Cloud
    //      Function/супер-админ ----
    //
    // ВАЖНО: было hasRole(..., ['owner', 'admin']) — из-за этого сотрудник,
    // присоединившийся по коду приглашения (см. SaasDeviceJoinService.
    // joinAsDevice, роль всегда 'employee'), успешно регистрировался
    // (devices/{uid} и tenantMembers оба создавались), но тут же падал с
    // permission-denied в TenantConfigService.refresh() — она читает
    // subscriptions/{tenantId} в общем Future.wait со всем остальным
    // конфигом, и вся пачка падает из-за одного запрещённого чтения.
    // Экран присоединения при этом показывал "не удалось присоединиться",
    // хотя устройство УЖЕ было зарегистрировано — отсюда несколько
    // задвоенных employee-регистраций от одного и того же теста. Здесь нет
    // ничего чувствительнее planId/status/дат (см. SubscriptionInfo) — это
    // ровно то, что SubscriptionGate обязан проверять на КАЖДОМ устройстве,
    // включая рядовых сотрудников, а не только владельца.
    // Для сети подписка одна на всю сеть (id документа == chainId, поле
    // chainId вместо tenantId — см. handleCreateChain в saas-gateway) —
    // читает любой активный участник ЛЮБОЙ точки сети (isChainMember).
    match /subscriptions/{subscriptionId} {
      allow read: if isSuperAdmin() ||
        (resource.data.get('tenantId', null) != null && isMember(resource.data.tenantId)) ||
        (resource.data.get('chainId', null) != null && isChainMember(resource.data.chainId));
      // Ручная правка подписки (по сути выдача доступа без оплаты) — только
      // через saas-gateway (handleOverrideSubscription), с записью в журнал
      // безопасности; остальное (оплаты, триал, продление) и так пишет он.
      allow write: if false;
    }

    // ---- Идемпотентность webhook'ов биллинга (handleBillingWebhook) — а
    //      заодно и история платежей для самого владельца (см. вкладку
    //      "Оплата" в консоли): владелец видит только события СВОЕГО
    //      заведения, супер-админ — все, писать сюда может только
    //      handleBillingWebhook (Admin SDK, вне этих правил) ----
    match /billingEvents/{paymentId} {
      allow read: if isSuperAdmin() ||
        (signedIn() && resource.data.tenantId != null && hasRole(resource.data.tenantId, ['owner', 'admin']));
      allow write: if false;
    }

    // ---- Сборки APK: владелец заведения видит и запрашивает свои,
    //      сам билд выполняет GitHub Actions + Cloud Function ----
    match /buildJobs/{buildId} {
      allow read: if isSuperAdmin() ||
        (signedIn() && hasRole(resource.data.tenantId, ['owner', 'admin']));
      // Создание job'а — только через Cloud Function createBuildJob
      // (проверяет лимиты тарифа, статус подписки, валидирует branding),
      // не напрямую с клиента.
      allow create: if false;
      allow update, delete: if isSuperAdmin();
    }

    // ---- Usage-счётчики заведения (считает calculateUsage раз в сутки,
    //      Cloud Function, admin SDK — не подчиняется этим правилам) ----
    // Владелец/админ видит, укладывается ли заведение в лимиты тарифа
    // (PlanLimits в lib/models/tenant_models.dart), супер-админ — usage
    // любого заведения для панели платформы.
    match /tenants/{tenantId}/usage/{doc} {
      allow read: if isSuperAdmin() || hasRole(tenantId, ['owner', 'admin']);
      allow write: if false;
    }

    // ---- Остальные внутренние коллекции заведения: склад, смены,
    //      скидочные карты, маркировка, очередь push, задачи ИИ ----
    //
    // ВАЖНО: здесь намеренно НЕТ рекурсивного match /tenants/{tenantId}/
    // {document=**} "на всё остальное". Firestore разрешает операцию, если
    // её пропускает ХОТЯ БЫ ОДНО подходящее правило (правила складываются
    // через ИЛИ, а не "самое специфичное побеждает") — поэтому такой
    // catch-all с условием isStaff(tenantId) тихо ПЕРЕКРЫВАЛ БЫ более узкие
    // ограничения выше (branding/employees/venueProfile/aiSettings/devices/
    // settings — там write разрешён только owner/admin, а catch-all снова
    // открывал бы его любому employee). Это реальный баг, пойманный
    // автоматическим тестом (saas/test/firestore.rules.test.js, "employee
    // читает столы, но не может менять брендинг") — поэтому вместо catch-all
    // каждая оставшаяся коллекция перечислена явно.
    match /tenants/{tenantId}/inventory/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/inventoryMovements/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/inventoryCounts/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/discountCards/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/shifts/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    // Личные смены сотрудников (учёт часов/зарплата, см. StaffShiftModel и
    // lib/screens/admin/{payroll_screen,staff_shifts_screen}.dart) — своя
    // коллекция, ОТДЕЛЬНАЯ от кассовых shifts выше. Забыли завести правило
    // при переносе этой фичи в SaaS — из-за этого openShiftIfNeeded/clockIn
    // падали permission-denied, а "Зарплата"/"Смены сотрудников" вечно
    // крутили спиннер (экраны не оборачивают загрузку в try/catch — см.
    // отдельный фикс там же).
    match /tenants/{tenantId}/staffShifts/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    // Служебные указатели текущей открытой смены — та же транзакция
    // openShiftIfNeeded/clockIn читает и пишет их АТОМАРНО вместе с
    // shifts/staffShifts выше: Firestore разрешает транзакцию, только
    // когда правила проходят ВСЕ операции внутри неё, поэтому без этих
    // двух документов транзакция целиком отклонялась, даже когда сама
    // запись в shifts/staffShifts была разрешена.
    match /tenants/{tenantId}/meta/shiftState {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/meta/staffShiftState {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/marking_codes_sold/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/aiJobs/{doc} {
      allow read, write: if isStaff(tenantId);
    }
    // Счётчик обращений гостя к ИИ — ведёт только Cloud Function (admin SDK,
    // вне этих правил); клиенту (даже персоналу) писать сюда незачем.
    match /tenants/{tenantId}/aiUsage/{doc} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    // Очередь push: пишут оба приложения (гость — только в СВОЁМ заведении),
    // читает и рассылает Cloud Function.
    match /tenants/{tenantId}/pushQueue/{doc} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId) || isTenantGuest(tenantId);
      allow update, delete: if false;
    }
  }
}
