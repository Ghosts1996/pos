rules_version = '2';

// Правила для двух приложений одного проекта:
//  • POS (сотрудники, анонимный вход) — полный доступ к рабочим данным;
//  • «Колибри Лаундж» (гости, анонимный вход или вход по телефону) —
//    только чтение витрины и запись в свои документы.
//
// Отличить гостя от сотрудника по анонимному входу нельзя, поэтому
// используется коллекция staffDevices/{uid}: POS при первом входе
// сотрудника создаёт документ с этим uid (см. AuthService), а клиентское
// приложение — нет. Всё, что не разрешено гостю явно, ему запрещено.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Устройство зарегистрировано как POS-планшет заведения.
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staffDevices/$(request.auth.uid));
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Регистрация POS-устройств ----
    // POS-планшет один раз регистрирует себя, передав секрет заведения
    // (meta/staffSecret.value) — его вводит администратор при установке
    // приложения на планшет. Гостевое приложение секрета не знает.
    match /staffDevices/{uid} {
      // ВАЖНО: читать можно только СВОЙ документ (или персоналу — все).
      // Раньше здесь стояло signedIn(), то есть документ мог прочитать любой
      // авторизованный — включая гостя из «Колибри Лаундж». А внутри
      // документа лежит поле secret с ключом заведения: гостю достаточно
      // было прочитать чужую запись, узнать ключ и зарегистрировать своё
      // устройство как рабочее, получив полный доступ к чекам, складу и
      // сотрудникам. Функция isStaff() ниже пользуется exists(), которому
      // права на чтение не нужны, поэтому сужение ничего не ломает.
      allow read: if isSelf(uid) || isStaff();
      allow create: if isSelf(uid) &&
        request.resource.data.secret ==
          get(/databases/$(database)/documents/meta/staffSecret).data.value;
      allow update, delete: if isStaff();
    }

    // Сам секрет читать нельзя никому из приложения — только сравнение
    // внутри правил выше; менять его можно из консоли Firebase.
    match /meta/staffSecret {
      allow read, write: if false;
    }

    // ---- Витрина: гость читает, пишет только персонал ----
    match /menuCategories/{doc} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /menuItems/{doc} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /tables/{doc} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ---- Чеки ----
    // Гость видит ТОЛЬКО тот чек, к которому сам привязан (свой стол).
    // Раньше читать мог любой авторизованный — то есть чужие счета тоже.
    function myActiveSession() {
      return get(/databases/$(database)/documents/clients/$(request.auth.uid))
                .data.activeSessionId;
    }

    match /sessions/{doc} {
      allow read: if isStaff() ||
        (signedIn() &&
         exists(/databases/$(database)/documents/clients/$(request.auth.uid)) &&
         myActiveSession() == doc);

      // Гость, привязанный к этому чеку (см. sessionClaims), может
      // подписать его своим именем — и больше ничего. Раньше update тоже
      // требовал isStaff(), и попытка гостевых приложений проставить
      // guestTag при посадке за стол всегда отклонялась: подпись на
      // плитке зала появлялась только если сотрудник вписывал её вручную.
      allow update: if isStaff() ||
        (signedIn() &&
         exists(/databases/$(database)/documents/sessionClaims/$(doc)) &&
         get(/databases/$(database)/documents/sessionClaims/$(doc)).data.uid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestTag']));

      allow create, delete: if isStaff();
    }

    // ---- Профили гостей ----
    match /clients/{uid} {
      allow read: if isSelf(uid) || isStaff();

      // Назвать чек своим можно, только если он закреплён за тобой в
      // sessionClaims. Раньше это проверяло только приложение, а правила
      // пропускали любую запись — и телефон со старой версией приложения
      // просто записывал себе чужой activeSessionId и садился на уже
      // занятый счёт. Проверка на сервере закрывает это независимо от
      // версии приложения: кто первым занял чек, за тем он и остаётся.
      //
      // currentSid — то, что стоит в профиле сейчас. Оставить как есть
      // можно всегда: иначе гость, привязанный ещё старой версией (без
      // записи в sessionClaims), не смог бы даже сменить имя.
      function sessionClaimOk(uid, currentSid) {
        let sid = request.resource.data.get('activeSessionId', '');
        return sid == '' || sid == currentSid ||
          (exists(/databases/$(database)/documents/sessionClaims/$(sid)) &&
           get(/databases/$(database)/documents/sessionClaims/$(sid)).data.uid == uid);
      }

      allow create: if isStaff() || (isSelf(uid) && sessionClaimOk(uid, ''));

      // Телефон гость задаёт один раз: к нему привязаны бонусы, и смена
      // номера означала бы доступ к чужому счёту. Менять его может только
      // персонал на кассе. Баланс бонусов гость не правит вовсе.
      allow update: if isStaff() ||
        (isSelf(uid) &&
         sessionClaimOk(uid, resource.data.get('activeSessionId', '')) &&
         (!('phone' in request.resource.data) ||
          resource.data.get('phone', '') == '' ||
          request.resource.data.phone == resource.data.phone) &&
         (!('bonusBalance' in request.resource.data.diff(resource.data).affectedKeys())) &&
         (!('tier' in request.resource.data.diff(resource.data).affectedKeys())) &&
         (!('totalSpent' in request.resource.data.diff(resource.data).affectedKeys())));

      allow delete: if isStaff();
    }

    // ---- Обезличенные указатели «номер → uid» и «код → uid» ----
    // Гостю нужно знать, занят ли телефон и существует ли реферальный код,
    // но читать чужие профили нельзя. Запрос по коллекции clients правила
    // отклоняют — из-за этого сохранение телефона зависало навсегда, а
    // реферальная программа молча не работала. Здесь лежит только пара
    // «ключ → uid»: ни имени, ни телефона владельца, ни бонусов.
    //
    // Занять ключ можно лишь тот, что свободен (create срабатывает только
    // для несуществующего документа) и только на себя — переписать чужой
    // указатель нельзя, поэтому увести чужой номер или код не получится.
    match /phoneIndex/{phone} {
      allow read: if signedIn();
      allow create: if isStaff() ||
        (signedIn() && request.resource.data.uid == request.auth.uid);
      allow update: if isStaff() ||
        (signedIn() &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isStaff();
    }

    match /referralCodes/{code} {
      allow read: if signedIn();
      allow create: if isStaff() ||
        (signedIn() && request.resource.data.uid == request.auth.uid);
      allow update: if isStaff() ||
        (signedIn() &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isStaff();
    }

    // ---- Закрепление чека за гостем ----
    // Один счёт — один гость: иначе двое, отсканировав один и тот же QR,
    // садились на один чек и оба им распоряжались. Проверить занятость
    // через clients нельзя (запрос по коллекции гостю запрещён), поэтому
    // она лежит здесь отдельным документом с одним полем uid.
    //
    // Занять можно только свободный чек (create срабатывает лишь для
    // несуществующего документа) и только на себя, а освободить — свой или
    // силами кассы. Так чек не «уводится» и не остаётся занятым навсегда.
    match /sessionClaims/{sessionId} {
      allow read: if signedIn();
      allow create: if isStaff() ||
        (signedIn() && request.resource.data.uid == request.auth.uid);
      allow update: if isStaff() ||
        (signedIn() &&
         resource.data.uid == request.auth.uid &&
         request.resource.data.uid == request.auth.uid);
      allow delete: if isStaff() ||
        (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---- Вечная история визитов гостя ----
    // Свои визиты гость видит, но не правит: запись создаёт касса при
    // закрытии чека. Отдельная подколлекция нужна потому, что сами чеки
    // (sessions) гостю читать нельзя — там счета других столов.
    match /clients/{uid}/visits/{visitId} {
      allow read: if isSelf(uid) || isStaff();
      allow write: if isStaff();
    }

    // ---- Брони ----
    match /reservations/{doc} {
      allow read: if isStaff() || (signedIn() && resource.data.clientUid == request.auth.uid);
      // Гость создаёт бронь только от своего имени и только как «новую».
      allow create: if isStaff() ||
        (signedIn() &&
         request.resource.data.clientUid == request.auth.uid &&
         request.resource.data.status == 'new');
      // Гость может отменить свою бронь и ответить «приду» на напоминание
      // за 20 минут. Больше ничего: подтверждение брони, назначение стола
      // и посадка — дело персонала.
      //
      // Ответ «приду» меняет ровно одно поле и не трогает статус, поэтому
      // разрешён отдельной веткой: иначе пришлось бы разрешить гостю
      // произвольную правку своей брони.
      allow update: if isStaff() ||
        (signedIn() &&
         resource.data.clientUid == request.auth.uid &&
         (request.resource.data.status == 'cancelled' ||
          (request.resource.data.status == resource.data.status &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['guestConfirmed']))));
      allow delete: if isStaff();
    }

    // ---- Обезличенное зеркало занятости столов бронями ----
    // Гостевому приложению нужно знать, какой стол и на какой интервал
    // занят, чтобы показать свободные слоты. Читать для этого саму
    // коллекцию reservations нельзя — там чужие имена и телефоны, и запрос
    // справедливо отклонялся правилом ниже (из-за чего экран брони у гостя
    // молча показывал «слотов нет»). Здесь лежат ТОЛЬКО обезличенные поля:
    // стол, интервал, признак «занимает» и uid владельца — по нему гость
    // может править запись своей брони и не может чужую.
    match /reservationSlots/{doc} {
      allow read: if signedIn();
      allow create: if isStaff() ||
        (signedIn() && request.resource.data.clientUid == request.auth.uid);
      allow update: if isStaff() ||
        (signedIn() &&
         resource.data.clientUid == request.auth.uid &&
         request.resource.data.clientUid == request.auth.uid);
      allow delete: if isStaff();
    }

    // ---- Вызовы персонала ----
    // Гость видит только свои вызовы — чтобы не читать, что происходит
    // за соседними столами.
    match /waiterCalls/{doc} {
      allow read: if isStaff() ||
        (signedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }

    // ---- Заказы гостя из-за стола ----
    match /guestOrders/{doc} {
      allow read: if isStaff() || (signedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.status == 'new';
      allow update, delete: if isStaff();
    }

    // ---- Отзывы ----
    match /reviews/{doc} {
      allow read: if isStaff() || (signedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }

    // ---- Бонусные операции: пишет только касса ----
    match /bonusOperations/{doc} {
      allow read: if isStaff() || (signedIn() && resource.data.clientUid == request.auth.uid);
      allow write: if isStaff();
    }

    // ---- Настройки ИИ ----
    // Ключ tooken.club нужен и клиентскому приложению (ИИ-консьерж),
    // поэтому документ читаем всем авторизованным, а меняет только персонал.
    // Если ключ не должен покидать POS — закройте read до isStaff() и
    // проксируйте запросы гостей через Cloud Function.
    match /meta/aiSettings {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /aiLogs/{doc} {
      allow read: if isStaff();
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }

    // ---- Действия ИИ и журнал кассы: только персонал ----
    match /aiActions/{doc} {
      allow read: if isStaff();
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }
    match /auditLog/{doc} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false; // журнал не редактируется
    }
    match /staffNotes/{doc} {
      allow read, write: if isStaff();
    }
    match /aiJobs/{doc} {
      allow read, write: if isStaff();
    }

    // ---- Лента для гостей ----
    match /stories/{doc} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ---- Очередь push ----
    // Пишут оба приложения, читает и рассылает Cloud Function
    // (у неё права администратора и правила на неё не распространяются).
    match /pushQueue/{doc} {
      allow read: if isStaff();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ---- Счётчик обращений гостя к ИИ (ведёт Cloud Function) ----
    match /aiUsage/{doc} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- Замок планировщика ИИ ----
    match /meta/aiSchedulerLock {
      allow read, write: if isStaff();
    }

    // ---- Лист ожидания ----
    match /waitlist/{doc} {
      allow read: if isStaff() || (signedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.status == 'waiting';
      // Гость может только выйти из очереди; приглашение и посадка — персонал.
      allow update: if isStaff() ||
        (signedIn() &&
         resource.data.clientUid == request.auth.uid &&
         request.resource.data.status == 'left');
      allow delete: if isStaff();
    }

    // ---- Счастливые часы и профиль заведения: витрина для гостя ----
    match /happyHours/{doc} {
      allow read: if signedIn();
      allow write: if isStaff();
    }
    match /meta/venueProfile {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    // ---- Сертификаты ----
    // Сертификат — это код на бонусы: гость вводит его в приложении, и
    // каждому успевшему начисляется указанная сумма.
    //
    // get, но НЕ list: код гость должен знать (его публикуют в канале), а
    // выкачать всю коллекцию и узнать коды будущих акций заранее — нет.
    match /giftCards/{code} {
      allow get: if signedIn();
      allow list: if isStaff();
      allow write: if isStaff();
    }
    match /giftCardOperations/{doc} {
      allow read, write: if isStaff();
    }

    // ---- Заявки на активацию сертификата ----
    // Начислить себе бонусы гость не может — правило на clients это
    // запрещает, и это главная защита от «выпишу себе десять тысяч».
    // Поэтому он оставляет заявку, а разбирает её касса: проверяет код,
    // считает активации и начисляет. Гость видит только свои заявки.
    match /giftCardClaims/{doc} {
      allow read: if isStaff() ||
        (signedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.clientUid == request.auth.uid &&
        request.resource.data.status == 'new' &&
        // Сумму проставляет касса при начислении: если её позволить
        // указывать гостю, он просто напишет себе любую.
        request.resource.data.amount == 0;
      allow update, delete: if isStaff();
    }

    // ---- Чаевые ----
    match /tips/{doc} {
      allow read: if isStaff() || (signedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.status == 'pending';
      allow update, delete: if isStaff();
    }

    // ---- Всё остальное (склад, смены, сотрудники, чеки ККТ, ЕГАИС) ----
    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
