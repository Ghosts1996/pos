# Файлы сборки и кэш инструментов — их не нужно коммитить, CI собирает всё
# заново на каждом запуске.
build/
.dart_tool/
.packages
.pub-cache/
.pub/
*.apk
*.aab

# Node-зависимости (functions/, saas/**) — ставятся заново через npm install,
# коммитить сотни мегабайт node_modules незачем и небезопасно (в них может
# оказаться что угодно, включая случайно затянутые бинарники).
node_modules/

# Если вы всё же сгенерируете android/ локально (например, чтобы настроить
# иконку приложения) и закоммитите её — эти файлы внутри неё всё равно
# останутся игнорируемыми, т.к. содержат секреты/локальные пути.
android/local.properties
**/android/key.properties
**/android/app/google-services.json
*.iml
.idea/
.vscode/
*.log
.backup-*/
keystore.base64
*.jks
key.properties
